# ===== AUTO Video Maker Environment Configuration =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ----- General -----
APP_ENV=development
LOG_LEVEL=INFO

# ----- Local media toolchain (FFmpeg) -----
# Required for voice, scenes, captions, and assembly. If ffmpeg/ffprobe are
# not on PATH, set FFMPEG_PATH to the ffmpeg executable (an absolute path or
# a directory containing ffmpeg.exe); ffprobe is derived from the same
# directory automatically, or set FFPROBE_PATH explicitly.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ----- Phase 1: Google Flow -----
FLOW_URL=https://flow.google
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# CDP_PORT=9222
# FLOW_AUTH_TIMEOUT=300
# FLOW_NAV_TIMEOUT=30
# FLOW_GEN_TIMEOUT=600
# FLOW_DOWNLOAD_TIMEOUT=120
# FLOW_POLL_INTERVAL=5

# ----- Future Phases (not active yet) -----

# ----- Video Generation (Future) -----
# GOOGLE_FLOW_EMAIL=your-email@example.com
# VEO_API_KEY=your-veo-api-key-here

# ----- Phase 7A: YouTube Publishing (OAuth 2.0, installed-app flow) -----
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (relative paths resolve against the git-ignored credentials/ directory).
# YOUTUBE_CLIENT_SECRETS_FILE=youtube_client_secret.json
# Path where the authorized OAuth token is persisted (never commit this file).
# YOUTUBE_TOKEN_FILE=youtube_token.json
# Default privacy status for uploads: public | unlisted | private.
# The code default is the conservative "unlisted"; nothing is published
# publicly unless explicitly configured here.
# YOUTUBE_PRIVACY_STATUS=unlisted

# ----- Phase 7B: YouTube Metadata Contract -----
# Comma-separated tags applied to uploads. Tags are also sourced from the
# production plan (metadata.tags) and niche/content-goal when present;
# duplicates are removed case-insensitively. Never invented at runtime.
# YOUTUBE_TAGS=education,nature facts
# YouTube category ID (validated against a whitelist; documented default is
# 27 = Education). See app/publishing/models.py YOUTUBE_CATEGORY_IDS.
# YOUTUBE_CATEGORY_ID=27
# Explicit made-for-kids declaration for uploads (true|false). Required to be
# deterministic; defaults to false.
# YOUTUBE_MADE_FOR_KIDS=false

# ----- Phase 8A: TikTok Publishing (official Content Posting API) -----
# Create a developer app at https://developers.tiktok.com, then add the
# "Content Posting API" product and request the video.publish scope.
# Register the redirect URI below (or your own) in the app settings.
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# Loopback redirect URI registered in the TikTok developer app settings.
# The code default is http://localhost:3455/callback/ which matches the
# portal registration for "Auto Video Maker Publisher"; set this variable
# only to override that default explicitly.
# TIKTOK_REDIRECT_URI=http://localhost:3455/callback/
# Path where the authorized OAuth token is persisted (never commit this file).
# TIKTOK_TOKEN_FILE=tiktok_token.json
# Post privacy level: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS |
# FOLLOWER_OF_CREATOR | SELF_ONLY. Conservative default SELF_ONLY; note that
# TikTok restricts ALL content from unaudited apps to private viewing until
# the app passes audit.
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# TikTok publishing environment context (Step 5J).
# "sandbox"  -> unaudited/Sandbox private publication behavior: a Direct Post
#               that returns PUBLISH_COMPLETE without a post_id under SELF_ONLY
#               terminates as VERIFIED_SANDBOX_PRIVATE.
# production -> default. PUBLISH_COMPLETE requires a public post_id for VERIFIED.
# TIKTOK_PUBLISH_ENVIRONMENT=production

# ----- TikTok Publishing (Future) -----
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ----- Phase 2B: AI Content Generation -----
# Default LLM provider (openrouter, gemini, mock).
# Phase 11C Batch 1: OpenRouter is the project's AI API router and the
# recommended runtime provider for local production planning. "mock" is an
# explicit offline/test mode (also selectable via AVM_MOCK_MODE=1) and its
# output never masquerades as AI production.
# ----- Batch 1C: Alibaba Cloud Model Studio (PRIMARY AI provider) -----
# Alibaba is AVM's PRIMARY provider; OpenRouter is the AUTOMATIC FALLBACK
# (classified, never blind, never parallel). AVM uses ONLY the dedicated
# Alibaba application/API credential (e.g. sk-ws-...). The Token Plan
# Personal Edition credential class (sk-sp-...) is FORBIDDEN inside AVM —
# it is reserved for interactive coding tools — and is explicitly rejected.
# The key is read from the environment only; never committed, never printed,
# never persisted in manifests/checkpoints, never included in provider errors.
# ALIBABA_API_KEY=your-avm-alibaba-application-key
# DashScope OpenAI-compatible endpoint (international region default;
# use https://dashscope.aliyuncs.com/compatible-mode/v1 for Beijing).
# ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Model selection is configuration-driven; these are the validated defaults.
# ALIBABA_TEXT_MODEL=qwen-plus
# ALIBABA_REASONING_MODEL=qwen-plus
# ALIBABA_VISION_MODEL=qwen-vl-plus
# ALIBABA_REQUEST_TIMEOUT=60
# Classified fallback switch. true (default) = eligible Alibaba failures
# fall back to OpenRouter; false = honest Alibaba-only operation (eligible
# failures fail truthfully). An UNCONFIGURED Alibaba credential NEVER falls
# back (invalid configuration stays truthful, never silently paid).
# ALIBABA_FALLBACK_ENABLED=true
# DashScope native async API base (image + video generation).
# AVM_ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com
# AI image generation (visual source 'alibaba', first child of the 'auto'
# chain). Cost-bearing per completed image; nothing is generated when unset.
# AVM_ALIBABA_IMAGE_MODEL=wan2.2-t2i-flash
# Explicit image size (W*H) override; defaults map the scene aspect ratio:
# 9:16 -> 720*1280, 16:9 -> 1280*720, else 1024*1024.
# AVM_ALIBABA_IMAGE_SIZE=1024*1024
# AI video generation (visual provider 'alibaba_video' with classified
# OpenRouter fallback). Cost-bearing per submitted task.
# AVM_ALIBABA_VIDEO_MODEL=wan2.2-t2v-plus
# Explicit size per aspect ratio (W*H, comma-separated). AVM never relies on
# provider defaults; unsupported aspect ratios fail truthfully.
# AVM_ALIBABA_VIDEO_SIZES=9:16=720*1280,16:9=1280*720
# Model-supported durations (seconds, comma-separated). Requests outside the
# model's supported durations fail truthfully BEFORE any billable submission.
# AVM_ALIBABA_VIDEO_DURATIONS=5,10
# Bounded polling for async tasks (never an infinite loop).
# AVM_ALIBABA_POLL_INTERVAL=10
# AVM_ALIBABA_POLL_MAX_ATTEMPTS=60
# Video-level fallback switch (independent of ALIBABA_FALLBACK_ENABLED).
# AVM_ALIBABA_FALLBACK_ENABLED=true
DEFAULT_LLM_PROVIDER=alibaba

# Google Gemini API (recommended)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API (project AI API router — runtime provider for local planning)
# OPENROUTER_API_KEY=your-openrouter-api-key
# Set OPENROUTER_MODEL explicitly; use a free/low-cost model for development
# (e.g. a free GLM chat model). The model is configuration, never hardcoded.
# OPENROUTER_MODEL=z-ai/glm-5.2:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----- Step 8: CodeCraft (AI Brain canonical-model text provider) -----
# Model-first planning. Declaring a canonical model on a production (K3 model
# picker -> explicit_constraints.canonical_model_id) routes the AI Brain
# through the EXISTING model resolver to this CodeCraft adapter, using the
# provider binding declared in the canonical model registry — never a provider
# picked here and never a different canonical model.
# This section changes NOTHING for productions that do not declare a canonical
# model: those keep the provider-first path driven by DEFAULT_LLM_PROVIDER
# (Alibaba -> OpenRouter classified fallback stays exactly as before), and
# video/audio/assembly routing is never affected by AI Brain model selection.
# The key is read from the environment only — never committed, never printed,
# never persisted into plan artifacts, provenance or accounting.
# An empty key simply means "not configured": model-first planning then fails
# truthfully (AllExactModelProvidersFailedError) instead of silently falling
# back to DEFAULT_LLM_PROVIDER.
CODECRAFT_API_KEY=
## Quarantined by default in new live deployments; opt in only after recovery.
AVM_ENABLE_CODECRAFT=0
CODECRAFT_BASE_URL=https://api.codecraft.ai/v1
CODECRAFT_TEXT_MODEL=qwen3.8-27b
CODECRAFT_REQUEST_TIMEOUT=

# LLM Request Settings
# LLM_REQUEST_TIMEOUT=60
# MAX_RETRY_ATTEMPTS=2

# ----- Content Generation Defaults -----
# DEFAULT_TARGET_DURATION=30
# DURATION_TOLERANCE=3.0
# DEFAULT_PLATFORM=youtube_shorts
# DEFAULT_LANGUAGE=en
# DEFAULT_NUMBER_OF_SCENES=6

# ----- Phase 2C: TTS Voice Generation -----
# Phase 11C Batch 1: Edge TTS is the real (free) narration provider for local
# production; "mock" generates a synthetic test tone and is an explicit test
# mode only — real production never reports spoken narration from it.
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-GuyNeural
# TTS_RATE=+0%
# TTS_VOLUME=+0%
# TTS_PITCH=+0Hz
# TTS_OUTPUT_FORMAT=mp3
# TTS_BITRATE=192k
# SCENE_PAUSE_DURATION=0.3
# VOICE_DURATION_WARNING_THRESHOLD=2.0
# VOICE_MAX_RETRIES=2

# ----- Step 6A/6B: Visual Provider Modes -----
# Project-level visual mode (--visual-mode): google_flow | local | hybrid.
# Persisted per project in manifest.scene_config; authoritative on resume.
# Local/hybrid asset directories (users supply their own assets):
# AVM_LOCAL_ASSET_DIR=C:\path\to\video-assets
# AVM_IMAGE_ASSET_DIR=C:\path\to\image-assets
# Hybrid routing defaults to image_motion for unrouted scenes; Flow scenes
# require explicit --route-scene scene_XXX=google_flow overrides.
#
# ----- Phase 6C: Per-project asset workflow -----
# Explicit per-scene assets are passed repeatable on the command line:
#   python produce.py --resume PROJECT_ID \
#     --asset scene_001="C:\assets\garden.jpg" \
#     --asset scene_002="C:\assets\b-roll.mp4"
#
# Each supplied file is validated, COPIED into the project's own store at
# output/projects/<project_id>/assets/source/<scene_id>.<ext>, SHA-256
# fingerprinted into output/projects/<project_id>/assets/asset_manifest.json,
# and re-verified against that fingerprint during every run's asset
# preflight. The stored project copy is then the only authoritative source:
# external originals may change or disappear without affecting the project.
# Scenes with no manifest entry keep legacy filename discovery above.


# ----- Phase 2D: Flow Scene Generation -----
# FLOW_SCENE_MODEL=Veo 3.1 - Lite
# FLOW_SCENE_ASPECT_RATIO=9:16
# FLOW_SCENE_DURATION=4
# FLOW_SCENE_COUNT=1
# FLOW_SCENE_AGENT_ENABLED=false
# FLOW_SCENE_MAX_PER_RUN=1
# FLOW_SCENE_CREDIT_LIMIT=10
# FLOW_SCENE_CONFIRMATION_REQUIRED=true
# FLOW_SCENE_TIMEOUT=600
# FLOW_SCENE_DOWNLOAD_TIMEOUT=120
# FLOW_SCENE_POLL_INTERVAL=5
# FLOW_SCENE_DURATION_TOLERANCE=1.0

# ----- Phase 7E: Generic OpenRouter video gateway -----
# The API key is never persisted in a project manifest or printed by AVM.
# Credential precedence (deterministic, Phase 11C Track 1 hardening):
# AVM_OPENROUTER_API_KEY wins, then the shared gateway credential
# OPENROUTER_API_KEY (same vendor; one deployed OpenRouter credential can
# serve both the LLM router and the video gateway). With neither set, the
# video gateway — and the Alibaba -> OpenRouter video fallback — is
# truthfully UNAVAILABLE; the runtime logs ONE warning naming the variables
# (never their values).
# AVM_OPENROUTER_API_KEY=your-openrouter-api-key
# AVM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AVM_OPENROUTER_MODEL=google/veo-3.1
# AVM_OPENROUTER_RESOLUTION=720p
# AVM_OPENROUTER_ALLOW_PAID=false
# AVM_OPENROUTER_ALLOW_PAID_FALLBACK=false
# AVM_OPENROUTER_GENERATE_AUDIO=false
# AVM_OPENROUTER_MODEL_CACHE=C:\path\to\openrouter-video-models.json
# AVM_OPENROUTER_MODEL_CACHE_TTL=900

# ----- Phase 11C Batch 1: local creation (visual routing / sources) -----
# Scene still-image source for the local ImageMotion route:
#   auto      -> visual ROUTING layer (DEFAULT): per-scene AI-vs-stock
#                routing over the configured children below, in the order
#                openrouter (when AVM_IMAGE_MODEL is set) -> pexels (when
#                PEXELS_API_KEY is set) -> wikimedia (free keyless fallback)
#   pexels    -> quality stock acquisition via the Pexels API (Pexels License)
#   openrouter-> AI image generation via the OpenRouter Image API
#                (POST /api/v1/images; requires AVM_IMAGE_MODEL)
#   wikimedia -> free Wikimedia Commons acquisition, no API key
#   fixture   -> deterministic colored test image; EXPLICIT test mode only
#   <other>   -> dormant external adapter boundary (never calls; fails truthfully)
# An explicit comma chain (e.g. AVM_IMAGE_SOURCE=openrouter,pexels) routes
# over exactly those sources in that order. Every source fails truthfully;
# nothing is fabricated and no unconfigured source is ever called silently.
# AVM_IMAGE_SOURCE=auto
#
# Quality stock source (Pexels). Free API key: https://www.pexels.com/api/
# (instant issuance; 200 requests/hour default). License and photographer
# provenance are recorded in the project asset manifest.
# PEXELS_API_KEY=your-pexels-api-key
#
# AI image generation (OpenRouter Image API). Uses the project's existing
# OPENROUTER_API_KEY gateway credential; the model must be an image-capable
# slug. Discover image-capable models:
#   GET https://openrouter.ai/api/v1/images/models
# (examples at time of writing: bytedance-seed/seedream-4.5,
# openai/gpt-image-2, qwen/qwen-image-3). Image generations are cost-bearing
# per completed image; nothing is generated when AVM_IMAGE_MODEL is unset.
# AVM_IMAGE_MODEL=bytedance-seed/seedream-4.5
#
# Explicit offline/mock execution mode for the web creation route. When truthy
# (1/true/yes/on) local productions use the mock planner, mock narration, and
# fixture imagery, and their output is labelled as test output.
# AVM_MOCK_MODE=0

# ----- Phase 11C Track 8: Local STT (Whisper) ----
# Local STT engine for SourceTranscript (Whisper). tiny is the smallest
# practical model. Overridable per-operator; the mock provider requires
# explicit provider=mock and is never the silent production fallback.
# Models are cached in the normal user cache (percent USERPROFILE percent slash .cache slash whisper); never committed to the repo.
# AVM_WHISPER_MODEL=tiny
# AVM_TRANSCRIPTION_PROVIDER=local_whisper

# ----- Future Phases -----
# GEMINI_API_KEY=your-gemini-api-key
# VEO_API_KEY=your-veo-api-key-here

# ----- YouTube Publishing (Future) -----
# YOUTUBE_CLIENT_ID=your-youtube-client-id
# YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# ----- TikTok Publishing (Future) -----
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
