__pycache__/
*.py[cod]
*$py.class
*.pyo

# ----- Python Distribution / Packaging -----
dist/
build/
*.egg-info/
*.egg

# ----- pytest -----
.pytest_cache/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo

# ----- OS Files -----
Thumbs.db
Desktop.ini
.DS_Store

